---
interface Props {
  collection: {
    title: string;
    url: string;
    cover?: string | null;
    thumbnail?: string | null;
    thumbnailPosition?: string;
    coverPosition?: string;
    glyph?: string;
    items: unknown[];
  };
}
const { collection } = Astro.props;
// thumbnail is tile-only; cover is used for both the tile and the page header.
const own = collection.thumbnail || collection.cover;
const image = own || '/images/banner.jpg';
const position = collection.thumbnail ? collection.thumbnailPosition || 'center' : own ? 'center' : collection.coverPosition || 'center';
---
<a class="tile" href={collection.url}>
  <span class="tile__frame">
    <img class:list={["tile__img", { "tile__img--crop": !own }]} src={image} alt="" loading="lazy" style={`object-position: ${position}`} />
    <span class="tile__glyph" aria-hidden="true">{collection.glyph}</span>
  </span>
  <span class="tile__label">{collection.title}</span>
  <span class="tile__count">{collection.items.length} {collection.items.length === 1 ? 'item' : 'items'}</span>
</a>
